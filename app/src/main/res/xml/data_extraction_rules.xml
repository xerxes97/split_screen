<?xml version="1.0" encoding="utf-8"?>
<!--
   Pro status is a local cache of Google Play Billing state and must never be
   restored or transferred; Billing re-derives it on the new device.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/pro_status.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/pro_status.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
